{
  "backend": "drive",
  "root_name": "Hemory-개인녹음",
  "inbox": "_inbox",
  "trash": "_trash",
  "state": "_state",
  "retention_days": 365,

  "_comment_local": "backend=local 이면 아래 경로(구글 드라이브 데스크톱 앱 동기화 폴더)를 씁니다.",
  "local_root": "~/Library/CloudStorage/GoogleDrive-<내계정>/내 드라이브/Hemory-개인녹음",

  "_comment_drive": "backend=drive 이면 OAuth 파일 경로입니다. hemory_auth.py 가 만들어 둡니다.",
  "credentials": "~/.config/hemory/client_secret.json",
  "token": "~/.config/hemory/token.json",

  "asr": {
    "engine": "auto",
    "whisper_model": "medium",
    "whisper_device": "cpu",
    "whisper_compute": "int8",
    "language": "ko",
    "_comment_vad": "침묵 구간 건너뛰기(기본 켜짐). min_silence_ms 를 키우면 더 긴 침묵만 건너뜁니다.",
    "vad": { "enabled": true, "min_silence_ms": 600, "threshold": 0.5 }
  },
  "diarization": { "method": "auto" },
  "summary": {
    "provider": "auto",
    "model": "gemini-2.5-flash",
    "api_key_env": "GEMINI_API_KEY"
  },
  "gemini_cli": "gemini",
  "max_minutes": 180
}
