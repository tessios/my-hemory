<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  설치:
    1) 이 파일의 __USER__ 와 __HEMORY_DIR__ 를 실제 값으로 바꿉니다.
    2) cp com.hemory.pipeline.plist ~/Library/LaunchAgents/
    3) launchctl load ~/Library/LaunchAgents/com.hemory.pipeline.plist
  확인: launchctl list | grep hemory     /     tail -f ~/Library/Logs/hemory-pipeline.log
  제거: launchctl unload ~/Library/LaunchAgents/com.hemory.pipeline.plist
  (30분마다 실행. 전원이 꺼져 있으면 다음 로그인 때 한 번 실행됩니다.)
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hemory.pipeline</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HEMORY_DIR__/run-hemory.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HEMORY_DIR</key><string>__HEMORY_DIR__</string>
    <key>HOME</key><string>/Users/__USER__</string>
  </dict>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/__USER__/Library/Logs/hemory-launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/__USER__/Library/Logs/hemory-launchd.log</string>
</dict>
</plist>
