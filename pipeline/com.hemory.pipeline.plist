<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hemory 상주 감시(준실시간) 데몬 — v1.6

  설치:
    1) 이 파일의 __USER__ 와 __HEMORY_DIR__ 를 실제 값으로 바꿉니다.
    2) cp com.hemory.pipeline.plist ~/Library/LaunchAgents/
    3) launchctl bootout gui/$(id -u)/com.hemory.pipeline 2>/dev/null
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hemory.pipeline.plist
  확인: launchctl print gui/$(id -u)/com.hemory.pipeline | grep -E "state|pid"
        tail -f ~/Library/Logs/hemory-pipeline.log
  제거: launchctl bootout gui/$(id -u)/com.hemory.pipeline
        mv ~/Library/LaunchAgents/com.hemory.pipeline.plist ~/

  · KeepAlive=true — 프로세스가 죽으면 launchd 가 곧바로 다시 띄운다(상주).
  · HEMORY_WATCH=1 — run-hemory.sh 가 `hemory_pipeline.py --watch` 로 실행된다(15초 폴링).
  · 예전 30분 원샷(StartInterval 1800)을 그대로 쓰려면 HEMORY_WATCH 를 지우거나 0 으로,
    StartInterval 을 1800 으로 되돌립니다.
  · 맥이 잠들면 프로세스도 멈춘다(깨어나면 launchd 가 다시 띄운다). 잠자기를 피하려면
    `sudo pmset -a sleep 0` 또는 `caffeinate -s` 를 함께 쓴다.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hemory.pipeline</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HEMORY_DIR__/run-hemory.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HEMORY_DIR</key><string>__HEMORY_DIR__</string>
    <key>HEMORY_WATCH</key><string>1</string>
    <key>HEMORY_INTERVAL</key><string>15</string>
    <key>HOME</key><string>/Users/__USER__</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/__USER__/Library/Logs/hemory-launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/__USER__/Library/Logs/hemory-launchd.log</string>
</dict>
</plist>
